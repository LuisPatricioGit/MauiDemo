<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiResources1.MainPage"
             Title="Página do Asterix"
             BackgroundColor="#89c4fe">

    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">

        <Image Source="{Binding Foto}" Aspect="Fill"/>
        <VerticalStackLayout HorizontalOptions="Center">
            <Label Text="{Binding Nome}" FontSize="30" />
            <Label Text="{Binding Sobrenome}" FontSize="30" />
            <Label Text="{Binding Idade}" FontSize="30" />
        </VerticalStackLayout>

    </StackLayout>

</ContentPage>
