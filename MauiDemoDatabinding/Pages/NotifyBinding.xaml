<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiDemoDatabinding.Pages.NotifyBinding"
             Title="Notify Binding">
    
    <VerticalStackLayout Spacing="20">
        <Entry Text="{Binding Nome}"
               FontSize="40"/>
        
        <Entry Text="{Binding Preco,
               StringFormat='{0:F2} €'}"
               FontSize="40"/>

        <Entry Text="{Binding Path=Stock,
               StringFormat='Quantidade: {0}'}"
               FontSize="40"/>

        <Button x:Name="btnActualiza"
                Text="Actualizar Produto"
                FontSize="20"
                Clicked="btnActualiza_Clicked"/>

    </VerticalStackLayout>
</ContentPage>