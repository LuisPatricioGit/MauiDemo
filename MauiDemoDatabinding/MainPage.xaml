<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MauiDemoDatabinding.Models"
             x:Class="MauiDemoDatabinding.MainPage">

    <ContentPage.BindingContext>
    <!--<ContentPage.Resource>-->
            <models:Produto x:Name="produto"
                        Nome="Sonic The Hedgehog"
                        Preco="10.00"
                        Stock="500" />
    <!--</ContentPage.Resource>-->
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout>


            <Label x:Name="lblNome"
                Text="{Binding Source={x:Reference produto}, Path=Nome}"
                FontSize="30"
                HorizontalOptions="Center"/>

            <Label x:Name="lblPreco"
                Text="{Binding Source={x:Reference produto}, 
                               Path=Preco,
                               StringFormat='{0:F2} €'}"
                FontSize="20"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <Label x:Name="lblStock"
                Text="{Binding Source={x:Reference produto}, 
                               Path=Stock,
                               StringFormat='Quantidade: {0}'}"
                FontSize="20"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <!--<Label x:Name="lblNome"
                Text="{Binding Nome, Source={StaticResource produto}}"
                FontSize="30"
                HorizontalOptions="Center"/>

            <Label x:Name="lblPreco"
                Text="{Binding Preco, Source={StaticResource produto}}"
                FontSize="20"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <Label x:Name="lblStock"
                Text="{Binding Stock, Source={StaticResource produto}}"
                FontSize="20"
                HorizontalOptions="Center"
                VerticalOptions="Center" />-->

            <!--<Button x:Name="CounterBtn"
                Text="Clique para realizar o DataBinding"
                Clicked="OnCounterClicked"
                HorizontalOptions="Center" />-->
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
